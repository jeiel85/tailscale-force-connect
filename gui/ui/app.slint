import { Button, ComboBox, CheckBox, Palette } from "std-widgets.slint";

// 최근 기록(connect.log) 한 줄. 시각은 따로 두어 내용이 여러 줄로 넘어가도 시각 열에 맞춰 들여 쓴다.
export struct LogLine {
    time: string,
    text: string,
    // 0 보통, 1 흐리게(--- 시작 ---), 2 경고(실패·오류·응답 없음 등)
    tone: int,
}

// 랜딩 페이지와 같은 색 체계. 밝은/어두운 테마는 시스템 설정을 따른다.
export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> bg: dark ? #0F151A : #EDF1F4;
    out property <color> card: dark ? #172028 : #FFFFFF;
    out property <color> card-border: dark ? #25313B : #DAE1E7;
    out property <color> chip: dark ? #1E2932 : #F2F5F8;
    out property <color> ink: dark ? #E6ECF0 : #14202B;
    out property <color> muted: dark ? #93A2AE : #56646F;
    out property <color> green: dark ? #3CC293 : #1B8F69;
    out property <color> amber: dark ? #F0A63A : #C9821A;
    out property <color> red: dark ? #F07A6A : #C2412D;
    out property <color> grey: dark ? #5E6C77 : #9AA6B0;
    out property <color> screen: #0E161D;
    out property <color> screen-ink: #CFE3D8;
    out property <color> screen-dim: #6A857A;
    out property <color> screen-warn: #F0B45A;
}

// 스크롤할 내용이 있을 때만 보이는 얇은 막대. 위치만 알려 주고, 스크롤은 마우스 휠로 한다.
// Flickable 옆(같은 부모)에 두고 x를 정해 겹쳐 그린다.
component ScrollThumb inherits Rectangle {
    in property <length> view-height;
    in property <length> content-height;
    // Flickable.content-y (맨 위가 0, 아래로 내릴수록 음수)
    in property <length> content-y;
    property <length> inset: 4px;
    property <length> track: root.view-height - 2 * root.inset;
    visible: root.content-height > root.view-height + 1px;
    width: 4px;
    border-radius: 2px;
    height: max(20px, root.track * (root.view-height / max(1px, root.content-height)));
    y: root.inset + (root.track - root.height) * (-root.content-y / max(1px, root.content-height - root.view-height));
}

component Card inherits Rectangle {
    background: Theme.card;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.card-border;
}

component SectionTitle inherits Text {
    color: Theme.muted;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.4px;
}

component Led inherits Rectangle {
    in property <color> tint;
    width: 20px;
    height: 20px;
    border-radius: 10px;
    background: tint;
    drop-shadow-blur: 14px;
    drop-shadow-color: tint.with-alpha(0.65);
}

// 줄바꿈되는 글. 레이아웃에 지금 너비에서 실제로 차지하는 높이를 알린다.
// Slint 1.18은 가로 레이아웃·그리드 칸 안의 줄바꿈 Text 높이를 칸보다 넓은 너비로 재서 낮게 잡는다.
// 그러면 화면 전체의 최소 높이가 실제보다 작아져, 창이 작을 때 아래쪽이 스크롤로도 보이지 않는다.
component WrapText {
    in property <string> text;
    in property <color> color: Theme.ink;
    in property <length> font-size: 12px;
    in property <int> font-weight: 400;
    height: label.preferred-height;
    label := Text {
        x: 0;
        y: 0;
        width: root.width;
        text: root.text;
        color: root.color;
        font-size: root.font-size;
        font-weight: root.font-weight;
        wrap: word-wrap;
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> dot;
    border-radius: 10px;
    background: Theme.chip;
    horizontal-stretch: 1;
    // 칩 3개가 한 줄에 들어가도록 점은 이름 옆에 둔다(한글은 글자 사이에서도 줄이 바뀌므로 값 칸을 넓게).
    VerticalLayout {
        padding-left: 12px;
        padding-right: 10px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 3px;
        HorizontalLayout {
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: dot;
                }
            }
            Text {
                text: label;
                color: Theme.muted;
                font-size: 11px;
                horizontal-stretch: 1;
            }
        }
        WrapText {
            text: value;
            font-size: 13px;
            font-weight: 700;
        }
    }
}

// Fluent 강조색(시스템 색)은 바꿀 수 없어서, 주 버튼만 브랜드 초록으로 직접 그린다.
component PrimaryButton inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }
    min-width: max(88px, label.preferred-width + 36px);
    min-height: 34px;
    border-radius: 7px;
    background: !root.enabled ? Theme.grey.with-alpha(0.5)
        : touch.pressed ? Theme.green.darker(0.18)
        : touch.has-hover ? Theme.green.brighter(0.1)
        : Theme.green;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.ink;
    label := Text {
        text: root.text;
        color: Theme.dark ? #08130E : #FFFFFF;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component LinkText inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 12px;
    out property <bool> hovered: touch.has-hover;
    callback clicked();
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }
    min-width: label.preferred-width;
    min-height: label.preferred-height;
    label := Text {
        text: root.text;
        font-size: root.font-size;
        color: touch.has-hover ? Theme.ink : Theme.muted;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component AppWindow inherits Window {
    title: "Tailscale Force Connect";
    icon: @image-url("../assets/icon.png");
    preferred-width: 540px;
    preferred-height: 740px;
    min-width: 480px;
    min-height: 560px;
    background: Theme.bg;
    default-font-family: "Malgun Gothic";
    default-font-size: 14px;

    in property <string> version: "1.8.0";
    in property <bool> installed;
    // running | stuck(켜져 있지만 서버와 연결 안 됨) | stopped | login | missing | unknown
    in property <string> state: "unknown";
    in property <string> state-title: "확인하는 중…";
    in property <string> state-detail;
    in property <string> boot-text: "확인하는 중…";
    in property <string> reconnect-text: "확인하는 중…";
    in property <bool> reconnect-on;
    in property <string> heal-text: "확인하는 중…";
    in property <bool> heal-on;
    in property <bool> fast-startup;
    in property <[LogLine]> log-lines;
    in property <[string]> reconnect-options: ["끄기", "30분", "1시간", "2시간", "4시간"];
    in-out property <int> reconnect-index: 2;
    in-out property <bool> run-test: false;
    in property <bool> busy;
    in property <string> busy-text;
    in property <bool> result-visible;
    in property <bool> result-ok;
    in property <string> result-title;
    in property <string> result-text;
    in-out property <bool> confirm-uninstall;
    in property <bool> update-available;
    in property <string> update-version;
    in-out property <string> update-status;
    in-out property <bool> show-update-prompt;
    // Windows 알림(끊김·재연결·멈춤 복구·새 버전). 사용자마다 따로 켜고 끈다.
    in-out property <bool> notify-on: true;
    // 원격 접속 중일 때 동작 확인 전에 띄우는 경고
    in-out property <bool> confirm-test-visible;
    in property <string> confirm-test-text;
    // 개발용: 시스템 테마와 상관없이 밝은 테마로 그린다(어두운 테마 PC에서 화면 확인).
    in property <bool> force-light;

    changed force-light => {
        if (self.force-light) {
            Palette.color-scheme = ColorScheme.light;
        }
    }

    // 최근 기록은 가장 최근 줄(맨 아래)이 보이게 둔다. 기록이 바뀌거나 칸 크기가 바뀌면 다시 맨 아래로.
    // (관리 창은 기록이 실제로 바뀐 때만 log-lines를 새로 넣으므로, 위로 올려 읽는 동안 끌려 내려가지 않는다.)
    function scroll-log-to-end() {
        log-view.content-y = min(0px, log-view.height - log-view.content-height);
    }
    changed log-lines => {
        root.scroll-log-to-end();
    }

    callback install();
    callback apply-reconnect();
    callback verify();
    callback uninstall();
    callback open-logs();
    callback open-url(string);
    callback dismiss-result();
    callback update();
    callback check-update();
    callback restart-tailscale();
    callback notify-toggled(bool);
    callback confirm-test();

    property <color> state-color: root.state == "running" ? Theme.green
        : (root.state == "stopped" || root.state == "stuck") ? Theme.amber
        : (root.state == "login" || root.state == "missing") ? Theme.red
        : Theme.grey;

    Timer {
        interval: 6s;
        running: root.update-status != "" && root.update-status != "확인하는 중…";
        triggered => {
            root.update-status = "";
        }
    }

    // 제거 버튼은 두 번 눌러야 한다. 4초 안에 다시 누르지 않으면 원래대로 돌아간다.
    Timer {
        interval: 4s;
        running: root.confirm-uninstall;
        triggered => {
            root.confirm-uninstall = false;
        }
    }

    // 창보다 내용이 길 때만(알림 배너가 여러 개 뜬 경우 등) 화면 전체를 세로로 스크롤한다. 가로로는 스크롤하지 않는다.
    // 내용이 창에 들어가면 최근 기록 칸이 남는 높이를 채운다.
    page-view := Flickable {
        content-width: self.width;

        VerticalLayout {
            padding: 18px;
            spacing: 12px;

            // 머리글
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 10px;
                Image {
                    source: @image-url("../assets/icon.png");
                    width: 26px;
                    height: 26px;
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "Tailscale Force Connect";
                        font-size: 15px;
                        font-weight: 700;
                        color: Theme.ink;
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: root.update-status != "" ? root.update-status : version-link.hovered ? "눌러서 새 버전 확인" : "";
                        color: Theme.muted;
                        font-size: 12px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    version-link := LinkText {
                        text: "v" + root.version;
                        clicked => {
                            root.check-update();
                        }
                    }
                }
            }

            // 새 버전 알림 (관리 창을 열 때 GitHub 최신 릴리스를 확인한다)
            if root.update-available: Rectangle {
                vertical-stretch: 0;
                border-radius: 12px;
                background: Theme.green.with-alpha(0.12);
                border-width: 1px;
                border-color: Theme.green.with-alpha(0.45);
                HorizontalLayout {
                    padding: 12px;
                    padding-left: 14px;
                    spacing: 12px;
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text {
                            text: "새 버전 v" + root.update-version;
                            font-weight: 700;
                            color: Theme.ink;
                        }
                        WrapText {
                            text: "설정은 그대로 두고, 연결을 끊지 않고 업데이트합니다.";
                            color: Theme.muted;
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        PrimaryButton {
                            text: "업데이트";
                            enabled: !root.busy;
                            clicked => {
                                root.update();
                            }
                        }
                    }
                }
            }

            // 현재 상태
            Card {
                vertical-stretch: 0;
                VerticalLayout {
                    padding: 18px;
                    spacing: 14px;
                    HorizontalLayout {
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            Led {
                                tint: root.state-color;
                            }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            Text {
                                text: root.state-title;
                                font-size: 24px;
                                font-weight: 800;
                                color: Theme.ink;
                            }
                            WrapText {
                                text: root.state-detail;
                                color: Theme.muted;
                                font-size: 13px;
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Chip {
                            label: "부팅할 때";
                            value: root.boot-text;
                            dot: root.installed ? Theme.green : Theme.grey;
                        }
                        Chip {
                            label: "직접 끊으면";
                            value: root.reconnect-text;
                            dot: root.reconnect-on ? Theme.green : Theme.grey;
                        }
                        Chip {
                            label: "멈추면";
                            value: root.heal-text;
                            dot: root.heal-on ? Theme.green : Theme.grey;
                        }
                    }
                }
            }

            // 설치된 경우: 자동 재연결 설정과 문제 해결 버튼
            if root.installed: Card {
                vertical-stretch: 0;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            horizontal-stretch: 1;
                            SectionTitle {
                                text: "직접 끊은 뒤 자동 재연결";
                            }
                        }
                        CheckBox {
                            text: "Windows 알림";
                            checked <=> root.notify-on;
                            toggled => {
                                root.notify-toggled(self.checked);
                            }
                        }
                    }
                    WrapText {
                        text: "트레이에서 Disconnect를 눌러도 이 시간이 지나면 다시 연결합니다. 1분마다 확인하므로 몇 분 늦을 수 있고, 끊기거나 다시 연결되면 Windows 알림으로 알려 드립니다.";
                        color: Theme.muted;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        ComboBox {
                            model: root.reconnect-options;
                            current-index <=> root.reconnect-index;
                            enabled: !root.busy;
                            horizontal-stretch: 1;
                        }
                        PrimaryButton {
                            text: "적용";
                            enabled: !root.busy;
                            clicked => {
                                root.apply-reconnect();
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.card-border;
                    }
                    // 버튼 너비를 맞춰 설명이 같은 자리에서 시작하게 한다.
                    GridLayout {
                        spacing-horizontal: 12px;
                        spacing-vertical: 8px;
                        Row {
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Button {
                                    text: "동작 확인";
                                    enabled: !root.busy;
                                    clicked => {
                                        root.verify();
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                WrapText {
                                    text: "연결을 몇 초 끊었다가 다시 연결되는지 봅니다. 원격으로 접속한 것 같으면 한 번 더 묻습니다.";
                                    color: Theme.muted;
                                }
                            }
                        }
                        Row {
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 0;
                                Button {
                                    text: "Tailscale 다시 시작";
                                    enabled: !root.busy;
                                    clicked => {
                                        root.restart-tailscale();
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                horizontal-stretch: 1;
                                WrapText {
                                    text: "트레이는 정상인데 다른 기기에서 접속이 안 될 때 누르세요. 연결이 잠깐 끊깁니다.";
                                    color: Theme.muted;
                                }
                            }
                        }
                    }
                }
            }

            // 설치되지 않은 경우: 설치
            if !root.installed: Card {
                vertical-stretch: 0;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    SectionTitle {
                        text: "설치";
                    }
                    WrapText {
                        text: "부팅할 때마다 Tailscale을 다시 연결하는 예약 작업을 등록합니다. 관리자 권한(UAC)이 한 번 필요합니다.";
                        color: Theme.muted;
                    }
                    HorizontalLayout {
                        spacing: 10px;
                        VerticalLayout {
                            alignment: center;
                            Text {
                                text: "직접 끊으면 다시 연결까지";
                                color: Theme.ink;
                                font-size: 13px;
                            }
                        }
                        ComboBox {
                            model: root.reconnect-options;
                            current-index <=> root.reconnect-index;
                            enabled: !root.busy;
                            horizontal-stretch: 1;
                        }
                    }
                    CheckBox {
                        text: "설치 후 동작 확인 (연결이 몇 초 끊김 · 원격 접속 중이면 끄세요)";
                        checked <=> root.run-test;
                        enabled: !root.busy;
                    }
                    PrimaryButton {
                        text: "설치하기";
                        enabled: !root.busy && root.state != "missing";
                        clicked => {
                            root.install();
                        }
                    }
                }
            }

            // 빠른 시작 경고
            if root.fast-startup: Rectangle {
                vertical-stretch: 0;
                border-radius: 12px;
                background: Theme.amber.with-alpha(0.13);
                border-width: 1px;
                border-color: Theme.amber.with-alpha(0.45);
                HorizontalLayout {
                    padding: 12px;
                    padding-left: 14px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: start;
                        padding-top: 5px;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.amber;
                        }
                    }
                    WrapText {
                        text: "Windows 빠른 시작이 켜져 있습니다. '종료 후 전원 켜기'에서는 부팅 시 연결이 실행되지 않습니다(재시작·정전 뒤에는 동작). 제어판 > 전원 옵션에서 끌 수 있습니다.";
                        horizontal-stretch: 1;
                    }
                }
            }

            // 마지막 작업 결과. 스크립트 출력이 길면 이 안에서만 스크롤한다.
            if root.result-visible: Rectangle {
                vertical-stretch: 0;
                border-radius: 12px;
                background: (root.result-ok ? Theme.green : Theme.red).with-alpha(0.12);
                border-width: 1px;
                border-color: (root.result-ok ? Theme.green : Theme.red).with-alpha(0.45);
                VerticalLayout {
                    padding: 12px;
                    padding-left: 14px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 10px;
                        WrapText {
                            text: root.result-title;
                            font-size: 14px;
                            font-weight: 700;
                            horizontal-stretch: 1;
                        }
                        LinkText {
                            text: "닫기";
                            clicked => {
                                root.dismiss-result();
                            }
                        }
                    }
                    Rectangle {
                        height: min(result-body.preferred-height, 120px);
                        result-view := Flickable {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            content-width: self.width;
                            result-body := VerticalLayout {
                                padding-right: 10px;
                                WrapText {
                                    text: root.result-text;
                                }
                            }
                        }
                        ScrollThumb {
                            x: parent.width - self.width;
                            view-height: result-view.height;
                            content-height: result-view.content-height;
                            content-y: result-view.content-y;
                            background: Theme.muted.with-alpha(0.5);
                        }
                    }
                }
            }

            // 최근 기록 (connect.log). 줄이 많아도 칸 밖으로 넘치지 않고 이 안에서 스크롤한다.
            Card {
                vertical-stretch: 1;
                min-height: 120px;
                VerticalLayout {
                    padding: 16px;
                    padding-top: 14px;
                    spacing: 10px;
                    HorizontalLayout {
                        SectionTitle {
                            text: "최근 기록";
                            horizontal-stretch: 1;
                        }
                        LinkText {
                            text: "로그 폴더 열기";
                            clicked => {
                                root.open-logs();
                            }
                        }
                    }
                    Rectangle {
                        background: Theme.screen;
                        border-radius: 10px;
                        clip: true;
                        vertical-stretch: 1;
                        // x·y를 직접 정해 두면 줄 수가 이 칸(과 창)의 최소 높이를 밀어 올리지 않는다.
                        log-view := Flickable {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            content-width: self.width;
                            changed height => {
                                root.scroll-log-to-end();
                            }
                            changed content-height => {
                                root.scroll-log-to-end();
                            }
                            VerticalLayout {
                                padding: 12px;
                                padding-right: 16px;
                                spacing: 4px;
                                alignment: end;
                                // 시각과 내용을 레이아웃 없이 직접 놓고, 줄 높이는 내용이 실제 너비에서 차지하는 높이로 정한다.
                                // (HorizontalLayout으로 묶으면 줄바꿈된 내용의 높이를 줄 전체 너비 기준으로 계산해 낮게 잡는다.)
                                for line in root.log-lines: Rectangle {
                                    height: log-text.preferred-height;
                                    log-time := Text {
                                        x: 0;
                                        y: 0;
                                        text: line.time;
                                        color: Theme.screen-dim;
                                        font-family: "Consolas";
                                        font-size: 12px;
                                    }
                                    log-text := Text {
                                        x: line.time == "" ? 0px : log-time.preferred-width + 10px;
                                        y: 0;
                                        width: parent.width - self.x;
                                        text: line.text;
                                        color: line.tone == 2 ? Theme.screen-warn : line.tone == 1 ? Theme.screen-dim : Theme.screen-ink;
                                        font-family: "Consolas";
                                        font-size: 12px;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                        // 위로 가려진 줄이 있으면 위쪽 끝을 흐리게 해 기록이 위로 이어진다는 것을 보여 준다.
                        if log-view.content-y < -1px: Rectangle {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: 18px;
                            background: @linear-gradient(180deg, Theme.screen 0%, Theme.screen.with-alpha(0) 100%);
                        }
                        if root.log-lines.length == 0: Text {
                            x: 0;
                            y: 0;
                            width: parent.width;
                            height: parent.height;
                            text: "아직 기록이 없습니다.";
                            color: Theme.screen-dim;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        ScrollThumb {
                            x: parent.width - self.width - 4px;
                            view-height: log-view.height;
                            content-height: log-view.content-height;
                            content-y: log-view.content-y;
                            background: Theme.screen-dim;
                        }
                    }
                }
            }

            // 바닥글
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 14px;
                if root.installed: Button {
                    text: root.confirm-uninstall ? "한 번 더 누르면 제거합니다" : "제거";
                    enabled: !root.busy;
                    clicked => {
                        if (root.confirm-uninstall) {
                            root.confirm-uninstall = false;
                            root.uninstall();
                        } else {
                            root.confirm-uninstall = true;
                        }
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    LinkText {
                        text: "GitHub";
                        clicked => {
                            root.open-url("https://github.com/jeiel85/tailscale-force-connect");
                        }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    LinkText {
                        text: "Made with Slint";
                        clicked => {
                            root.open-url("https://slint.dev");
                        }
                    }
                }
            }
        }
    }
    ScrollThumb {
        x: parent.width - self.width - 3px;
        view-height: page-view.height;
        content-height: page-view.content-height;
        content-y: page-view.content-y;
        background: Theme.muted.with-alpha(0.6);
    }

    // 새 버전을 찾으면 띄우는 알림 창. [나중에]를 누르면 위쪽 초록 알림만 남는다.
    if root.show-update-prompt && !root.busy: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.dark ? #000000a0 : #14202B80;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 60px, 380px);
            height: prompt-layout.preferred-height;
            border-radius: 14px;
            background: Theme.card;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000060;
            prompt-layout := VerticalLayout {
                padding: 22px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 24px;
                        height: 24px;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: "새 버전 v" + root.update-version;
                            font-size: 16px;
                            font-weight: 700;
                            color: Theme.ink;
                        }
                    }
                }
                Text {
                    text: "지금 업데이트할까요? 설정은 그대로 두고 연결을 끊지 않습니다. 관리 창이 닫혔다가 새 버전으로 다시 열립니다.";
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Button {
                        text: "나중에";
                        clicked => {
                            root.show-update-prompt = false;
                        }
                    }
                    PrimaryButton {
                        text: "지금 업데이트";
                        clicked => {
                            root.show-update-prompt = false;
                            root.update();
                        }
                    }
                }
            }
        }
    }

    // 원격 데스크톱이나 Tailscale로 접속 중인 것 같을 때 동작 확인(연결을 몇 초 끊음) 전에 한 번 더 묻는다.
    if root.confirm-test-visible && !root.busy: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.dark ? #000000a0 : #14202B80;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 60px, 400px);
            height: confirm-layout.preferred-height;
            border-radius: 14px;
            background: Theme.card;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000060;
            confirm-layout := VerticalLayout {
                padding: 22px;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: Theme.amber;
                        }
                    }
                    Text {
                        text: "원격으로 접속 중인 것 같습니다";
                        font-size: 16px;
                        font-weight: 700;
                        color: Theme.ink;
                        horizontal-stretch: 1;
                    }
                }
                Text {
                    text: root.confirm-test-text;
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    Button {
                        text: "그래도 확인";
                        clicked => {
                            root.confirm-test();
                        }
                    }
                    PrimaryButton {
                        text: "취소";
                        clicked => {
                            root.confirm-test-visible = false;
                        }
                    }
                }
            }
        }
    }

    // 관리자 권한 작업 중에는 화면을 덮어 다른 조작을 막는다.
    if root.busy: Rectangle {
        width: 100%;
        height: 100%;
        background: Theme.dark ? #000000b0 : #14202B90;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 60px, 360px);
            height: busy-layout.preferred-height;
            border-radius: 14px;
            background: Theme.card;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000060;
            busy-layout := VerticalLayout {
                padding: 22px;
                spacing: 8px;
                Text {
                    text: "잠시만 기다려 주세요";
                    font-size: 16px;
                    font-weight: 700;
                    color: Theme.ink;
                }
                Text {
                    text: root.busy-text;
                    color: Theme.muted;
                    font-size: 13px;
                    wrap: word-wrap;
                }
            }
        }
    }
}
